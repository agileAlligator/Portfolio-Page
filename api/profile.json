---
# The résumé as JSON, built from _config.yml and _data/{career,projects,
# credentials,skills}.yml, the same files the homepage renders. Read
# server-side by the MCP Worker (mcp-worker/src/index.js).
layout: null
permalink: /api/profile.json
---
{%- assign projects = site.data.projects.built | concat: site.data.projects.smaller -%}
{
  "name": {{ site.title | jsonify }},
  "tagline": {{ site.tagline | jsonify }},
  "whoami": {{ site.title | append: " — " | append: site.tagline | append: ". " | append: site.description | strip | jsonify }},
  "experience": [
{%- for job in site.data.career reversed %}
    { "role": {{ job.role | jsonify }}, "org": {{ job.org | jsonify }}, "start": {{ job.start | jsonify }}, "end": {{ job.end | jsonify }}, "location": {{ job.location | jsonify }}, "description": {{ job.desc | jsonify }} }{% unless forloop.last %},{% endunless %}
{%- endfor %}
  ],
  "projects": [
{%- for p in projects %}
{%- if p.url -%}
  {%- assign desc = p.title | append: " " | append: p.desc -%}
  {%- if p.url contains "github.com" %}{% assign label = "GitHub" %}{% else %}{% assign label = "Open" %}{% endif -%}
{%- else -%}
  {%- assign desc = p.desc -%}
{%- endif %}
    {
      "id": {{ p.id | jsonify }},
      "title": {{ p.title | jsonify }},
      "tags": {{ p.meta | jsonify }},
      "description": {{ desc | strip_html | split: " " | join: " " | jsonify }},
      "links": [
{%- if p.url %}{ "label": {{ label | jsonify }}, "url": {{ p.url | absolute_url | jsonify }} }{% if p.extra_links %},{% endif %}{% endif -%}
{%- assign links = p.links | default: p.extra_links -%}
{%- for l in links %}{ "label": {{ l.label | jsonify }}, "url": {{ l.url | absolute_url | jsonify }} }{% unless forloop.last %}, {% endunless %}{% endfor -%}
      ],
      "links_note": {{ p.links_aside | jsonify }},
      "note": {{ p.note | jsonify }}
    }{% unless forloop.last %},{% endunless %}
{%- endfor %}
  ],
  "skills": [
{%- for s in site.data.skills %}
    { "group": {{ s.group | jsonify }}, "items": {{ s.items | jsonify }} }{% unless forloop.last %},{% endunless %}
{%- endfor %}
  ],
  "credentials": [
{%- for c in site.data.credentials %}
    { "kind": {{ c.kind | jsonify }}, "text": {{ c.text | jsonify }}, "url": {{ c.url | jsonify }} }{% unless forloop.last %},{% endunless %}
{%- endfor %}
  ],
  "resume_pdf": {{ "/resume.pdf" | absolute_url | jsonify }},
  "contact": {
    "email": {{ site.author.email | jsonify }},
{%- for l in site.social.links %}
{%- if l contains "github.com" %}
    "github": {{ l | jsonify }},
{%- elsif l contains "linkedin.com" %}
    "linkedin": {{ l | jsonify }},
{%- endif %}
{%- endfor %}
    "site": {{ site.url | jsonify }}
  }
}
